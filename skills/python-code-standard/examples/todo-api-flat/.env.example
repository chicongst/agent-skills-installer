# Copy to .env for local development and run with `uv run --env-file .env ...`.
# The app never reads .env by itself, so a stray file on a server cannot change production settings.
TASKBOARD_ENVIRONMENT=development
TASKBOARD_STORAGE__DRIVER=memory
TASKBOARD_AUTH__ISSUER=https://dev.local
TASKBOARD_AUTH__AUDIENCE=taskboard
TASKBOARD_AUTH__PUBLIC_KEY_FILE=.dev/jwt-public.pem
TASKBOARD_LOG_FORMAT=console
TASKBOARD_DOCS_ENABLED=true
