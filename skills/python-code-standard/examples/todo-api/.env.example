# Copy to .env for local development and run with `uv run --env-file .env ...`.
# The app never reads .env by itself, so a stray file on a server cannot change production settings.
TODO_ENVIRONMENT=development
TODO_STORAGE__DRIVER=memory
# TODO_STORAGE__DRIVER=postgres
# TODO_STORAGE__DATABASE_URL=postgresql+asyncpg://todo:${TODO_DB_PASSWORD}@localhost:5432/todo
TODO_AUTH__ISSUER=https://dev.local
TODO_AUTH__AUDIENCE=todo-api
TODO_AUTH__PUBLIC_KEY_FILE=.dev/jwt-public.pem
TODO_LOG_FORMAT=console
TODO_DOCS_ENABLED=true
